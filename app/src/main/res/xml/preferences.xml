<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Privacy &amp; Security">
        <SwitchPreferenceCompat
            app:key="filtering_enabled"
            app:title="Tracking Protection"
            app:defaultValue="true" />
        <EditTextPreference
            app:key="whitelist"
            app:title="Site Whitelist"
            app:dialogTitle="Whitelisted Domains" />
        <ListPreference
            app:key="cookie_mode"
            app:title="Cookie Policy"
            app:entries="@array/cookie_entries"
            app:entryValues="@array/cookie_values"
            app:defaultValue="recommended" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Appearance &amp; General">
        <ListPreference
            app:key="dark_mode"
            app:title="Content Dark Mode"
            app:entries="@array/dark_entries"
            app:entryValues="@array/dark_values"
            app:defaultValue="dark" />
        <EditTextPreference
            app:key="homepage"
            app:title="Home URL"
            app:defaultValue="https://m.youtube.com" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Data Management">
        <Preference
            app:key="clear_history"
            app:title="Clear History" />
        <Preference
            app:key="clear_cache"
            app:title="Clear Web Cache" />
        <Preference
            app:key="clear_cookies"
            app:title="Clear Cookies &amp; Data" />
    </PreferenceCategory>

    <PreferenceCategory app:title="About">
        <Preference
            app:key="about"
            app:title="About App" />
        <Preference
            app:key="version"
            app:title="App Version" />
    </PreferenceCategory>
</PreferenceScreen>
